# The public Mudbase project/collection backing this blog. Reads are anonymous
# (collection permission: role "public", actions ["read"], conditions status=published),
# so no API key is required to render the site — these two IDs are not secret.
MUDBASE_PROJECT_ID=6a8b001ccd3ed654823a5732
MUDBASE_COLLECTION_ID=6a8b005ccd3ed654823a5743

# ---------------------------------------------------------------------------
# Blog admin (/admin). Required only for writing posts; the public site renders
# without any of these.
#
# NONE of these may take a NEXT_PUBLIC_ prefix. That prefix compiles the value
# into the browser bundle, which would publish the admin password and hand every
# visitor a write-capable API key.
#
# Generate a complete set with:
#   flyctl ssh console -a mudbase-server \
#     -C "node scripts/createBlogAdminCreds.js --password='<password>'"
# ---------------------------------------------------------------------------

# Shared sign-in password for /admin.
BLOG_ADMIN_PASSWORD=

# HMAC key for the admin session cookie. At least 16 characters; the app refuses
# to sign sessions with anything shorter rather than issue forgeable tokens.
BLOG_ADMIN_SECRET=

# Mudbase API key used server-side to write posts and upload images. Scope it to
# database:create/read/update/delete and storage:create/read — nothing else.
MUDBASE_API_KEY=

# Optional. Storage bucket for cover images. Left unset, the first public bucket
# in the project is used and cached for the life of the server process.
MUDBASE_BUCKET_ID=

# Optional. Override the API host (defaults to https://api.mudbase.dev).
MUDBASE_API_BASE=
